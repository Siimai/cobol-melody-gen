//@USER@P  JOB (1),'CMDPROC',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1),
//         USER=@USER@,PASSWORD=@PASS@
//* Copies the shared CLISTs into SYS2.CMDPROC so that every user can
//* type MELPANEL or MELODY (both call MELSETUP).  Needs ALTER on SYS2.* (group ADMIN).
//* Rerun after changing the CLISTs; run install-cntl.jcl first.
//PANEL    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=MELODY.SOURCE.CLIST(MELPANEL),DISP=SHR
//SYSUT2   DD DSN=SYS2.CMDPROC(MELPANEL),DISP=SHR
//SETUP    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=MELODY.SOURCE.CLIST(MELSETUP),DISP=SHR
//SYSUT2   DD DSN=SYS2.CMDPROC(MELSETUP),DISP=SHR
//MENU     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=A
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=MELODY.SOURCE.CLIST(MELODY),DISP=SHR
//SYSUT2   DD DSN=SYS2.CMDPROC(MELODY),DISP=SHR
//
