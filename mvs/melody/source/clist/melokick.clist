PROC 0
CONTROL NOFLUSH NOPROMPT
%MELSETUP
ALLOC FILE(MELSAVE) DATASET('&SYSUID..MELODY.SAVEV') SHR REUSE
IF &LASTCC = 0 THEN GOTO HAVEV
WRITE CREATING &SYSUID..MELODY.SAVEV
DEFINE CLUSTER (NAME('&SYSUID..MELODY.SAVEV') INDEXED KEYS(3 0) +
  RECORDSIZE(80 80) CYLINDERS(1 1) VOLUMES(PUB000) UNIQUE) +
  DATA(NAME('&SYSUID..MELODY.SAVEV.DATA')) +
  INDEX(NAME('&SYSUID..MELODY.SAVEV.INDEX'))
ALLOC FILE(MELSAVE) DATASET('&SYSUID..MELODY.SAVEV') SHR REUSE
HAVEV: ATTRIB MELKATTR RECFM(F) LRECL(80) BLKSIZE(80)
ALLOC FILE(MELMIDI) DATASET('&SYSUID..MELODY.MIDIK') OLD REUSE
IF &LASTCC = 0 THEN GOTO HAVEM
WRITE CREATING &SYSUID..MELODY.MIDIK
ALLOC FILE(MELMIDI) DATASET('&SYSUID..MELODY.MIDIK') NEW CATALOG +
  TRACKS SPACE(1,1) USING(MELKATTR) REUSE
OPENFILE MELMIDI OUTPUT
CLOSFILE MELMIDI
HAVEM: FREE ATTRLIST(MELKATTR)
KICKS PPT(ML) PCT(ML) FCT(ML) DCT(ML)
FREE FILE(MELSAVE MELMIDI)
