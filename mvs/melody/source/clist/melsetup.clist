PROC 0
CONTROL NOFLUSH NOPROMPT
ATTRIB MELATTR RECFM(F B) LRECL(80) BLKSIZE(800)
SET &N = 1
NEXT: IF &N > 4 THEN GOTO FIN
IF &N = 1 THEN SET &DSN = RUNJCL
IF &N = 2 THEN SET &DSN = OUT
IF &N = 3 THEN SET &DSN = SAVED
IF &N = 4 THEN SET &DSN = MIDI
SET &SP = 1
IF &DSN = SAVED THEN SET &SP = 5
ALLOC FILE(&DSN) DATASET('&SYSUID..MELODY.&DSN') SHR REUSE
SET &RC = &LASTCC
IF &RC = 0 THEN GOTO OK
WRITE  CREATING &SYSUID..MELODY.&DSN
ALLOC FILE(&DSN) DATASET('&SYSUID..MELODY.&DSN') NEW CATALOG TRACKS +
  SPACE(&SP,&SP) USING(MELATTR) REUSE
OPENFILE &DSN OUTPUT
CLOSFILE &DSN
OK: FREE FILE(&DSN)
SET &N = &N + 1
GOTO NEXT
FIN: FREE ATTRLIST(MELATTR)
