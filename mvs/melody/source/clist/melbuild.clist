PROC 0 WHAT(ALL)
CONTROL NOFLUSH
IF &WHAT = COBOL THEN GOTO DOCOB
IF &WHAT = ASM THEN GOTO DOASM
IF &WHAT = CLIST THEN GOTO DOCL
IF &WHAT = ALL THEN GOTO DOCOB
WRITE  USE: MELBUILD WHAT(ALL OR COBOL OR ASM OR CLIST)
EXIT
DOCOB: SUBMIT 'MELODY.SOURCE.CNTL(SETUP)'
IF &WHAT = COBOL THEN EXIT
DOASM: SUBMIT 'MELODY.SOURCE.CNTL(MELSCR)'
IF &WHAT = ASM THEN EXIT
DOCL: SUBMIT 'MELODY.SOURCE.CNTL(CMDPROC)'
EXIT
