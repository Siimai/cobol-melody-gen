ST03     DFHMDF POS=(10,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD04     DFHMDF POS=(11,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST04     DFHMDF POS=(11,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD05     DFHMDF POS=(12,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST05     DFHMDF POS=(12,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD06     DFHMDF POS=(13,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST06     DFHMDF POS=(13,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
