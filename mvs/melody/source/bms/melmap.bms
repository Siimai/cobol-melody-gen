ST07     DFHMDF POS=(14,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD08     DFHMDF POS=(15,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST08     DFHMDF POS=(15,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD09     DFHMDF POS=(16,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST09     DFHMDF POS=(16,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD10     DFHMDF POS=(17,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST10     DFHMDF POS=(17,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD11     DFHMDF POS=(18,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST11     DFHMDF POS=(18,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD12     DFHMDF POS=(19,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST12     DFHMDF POS=(19,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD13     DFHMDF POS=(20,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST13     DFHMDF POS=(20,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD14     DFHMDF POS=(21,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST14     DFHMDF POS=(21,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
         DFHMSD TYPE=FINAL
         END
