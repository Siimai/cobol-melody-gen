         PRINT NOGEN
MELMAP   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               EXTATT=YES,CTRL=(FREEKB,FRSET)
MELMP1   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=31,ATTRB=(ASKIP,BRT),COLOR=YELLOW,    X
               INITIAL='MELO - MELODY GENERATOR (KICKS)'
         DFHMDF POS=(2,1),LENGTH=5,ATTRB=(ASKIP,BRT),COLOR=YELLOW,     X
               INITIAL='INPUT'
DV2      DFHMDF POS=(2,41),LENGTH=1,ATTRB=ASKIP,COLOR=BLUE
         DFHMDF POS=(2,44),LENGTH=6,ATTRB=(ASKIP,BRT),COLOR=YELLOW,    X
               INITIAL='RESULT'
         DFHMDF POS=(3,1),LENGTH=39,ATTRB=ASKIP,COLOR=BLUE,            X
               INITIAL='---------------------------------------'
PLUS     DFHMDF POS=(3,41),LENGTH=1,ATTRB=ASKIP,COLOR=BLUE
         DFHMDF POS=(3,43),LENGTH=35,ATTRB=ASKIP,COLOR=BLUE,           X
               INITIAL='-----------------------------------'
         DFHMDF POS=(4,2),LENGTH=28,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='SCALE  (1-8, BLANK = RANDOM)'
SCALE    DFHMDF POS=(4,34),LENGTH=1,ATTRB=(UNPROT,NUM,IC),COLOR=GREEN, X
               HILIGHT=UNDERLINE
         DFHMDF POS=(4,36),LENGTH=1,ATTRB=ASKIP
DV4      DFHMDF POS=(4,41),LENGTH=1,ATTRB=ASKIP,COLOR=BLUE
         DFHMDF POS=(4,44),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='SCALE  :'
SNAME    DFHMDF POS=(4,53),LENGTH=16,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(5,2),LENGTH=30,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='EIGHTHS (8-16, BLANK = RANDOM)'
NLEN     DFHMDF POS=(5,34),LENGTH=2,ATTRB=(UNPROT,NUM),COLOR=GREEN,    X
               HILIGHT=UNDERLINE
         DFHMDF POS=(5,37),LENGTH=1,ATTRB=ASKIP
DV5      DFHMDF POS=(5,41),LENGTH=1,ATTRB=ASKIP,COLOR=BLUE
         DFHMDF POS=(5,44),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='LENGTH :'
RNOTES   DFHMDF POS=(5,53),LENGTH=24,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(6,2),LENGTH=29,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='TEMPO  (040-240, BLANK = 120)'
TEMPO    DFHMDF POS=(6,34),LENGTH=3,ATTRB=(UNPROT,NUM),COLOR=GREEN,    X
               HILIGHT=UNDERLINE
         DFHMDF POS=(6,38),LENGTH=1,ATTRB=ASKIP
DV6      DFHMDF POS=(6,41),LENGTH=1,ATTRB=ASKIP,COLOR=BLUE
         DFHMDF POS=(6,44),LENGTH=8,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='TEMPO  :'
RTEMP    DFHMDF POS=(6,53),LENGTH=8,ATTRB=(ASKIP,BRT),COLOR=YELLOW
MSG      DFHMDF POS=(22,1),LENGTH=70,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(23,1),LENGTH=42,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='ENTER=RUN   PF5=SAVE   PF6=LIST   PF7=MIDI'
         DFHMDF POS=(24,1),LENGTH=20,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='PF3=EXIT   CLEAR=NEW'
MELMP2   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=31,ATTRB=(ASKIP,BRT),COLOR=YELLOW,    X
               INITIAL='MELO - MELODY GENERATOR (KICKS)'
         DFHMDF POS=(3,1),LENGTH=24,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='SAVED MELODIES (LAST 10)'
ROW01    DFHMDF POS=(5,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW02    DFHMDF POS=(6,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW03    DFHMDF POS=(7,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW04    DFHMDF POS=(8,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW05    DFHMDF POS=(9,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW06    DFHMDF POS=(10,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW07    DFHMDF POS=(11,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW08    DFHMDF POS=(12,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW09    DFHMDF POS=(13,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW10    DFHMDF POS=(14,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(17,1),LENGTH=13,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='LOAD NUMBER :'
LD       DFHMDF POS=(17,15),LENGTH=3,ATTRB=(UNPROT,NUM,IC),COLOR=GREEN,X
               HILIGHT=UNDERLINE
         DFHMDF POS=(17,19),LENGTH=1,ATTRB=ASKIP
MSG2     DFHMDF POS=(22,1),LENGTH=70,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(24,1),LENGTH=26,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='ENTER=LOAD  PF3=BACK'
MELMP3   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
SCUR     DFHMDF POS=(4,34),LENGTH=1,ATTRB=(UNPROT,IC),COLOR=GREEN,     X
               HILIGHT=UNDERLINE
HD01     DFHMDF POS=(8,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST01     DFHMDF POS=(8,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
HD02     DFHMDF POS=(9,2),LENGTH=14,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ST02     DFHMDF POS=(9,17),LENGTH=50,ATTRB=(ASKIP,BRT),COLOR=TURQUOISE
