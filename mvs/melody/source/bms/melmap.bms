         PRINT NOGEN
MELMAP   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               CTRL=(FREEKB,FRSET)
MELMP1   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=31,ATTRB=(ASKIP,BRT),                 X
               INITIAL='MELO - MELODY GENERATOR (KICKS)'
         DFHMDF POS=(3,1),LENGTH=28,ATTRB=ASKIP,                       X
               INITIAL='SCALE (1-8, BLANK = RANDOM)'
SCALE    DFHMDF POS=(3,31),LENGTH=1,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(3,33),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(4,1),LENGTH=28,ATTRB=ASKIP,                       X
               INITIAL='LENGTH (08-16, BLANK=RANDOM)'
NLEN     DFHMDF POS=(4,31),LENGTH=2,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(4,34),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(5,1),LENGTH=28,ATTRB=ASKIP,                       X
               INITIAL='TEMPO (040-240 BPM, DEF 120)'
TEMPO    DFHMDF POS=(5,31),LENGTH=3,ATTRB=(UNPROT,NUM)
         DFHMDF POS=(5,35),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(7,1),LENGTH=6,ATTRB=ASKIP,INITIAL='SCALE:'
SNAME    DFHMDF POS=(7,8),LENGTH=16,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(8,1),LENGTH=6,ATTRB=ASKIP,INITIAL='NOTES:'
NCOUNT   DFHMDF POS=(8,8),LENGTH=2,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(8,12),LENGTH=6,ATTRB=ASKIP,INITIAL='TEMPO:'
NTEMPO   DFHMDF POS=(8,19),LENGTH=3,ATTRB=(ASKIP,BRT)
NOTES1   DFHMDF POS=(10,1),LENGTH=20,ATTRB=(ASKIP,BRT)
NOTES2   DFHMDF POS=(11,1),LENGTH=20,ATTRB=(ASKIP,BRT)
NOTES3   DFHMDF POS=(12,1),LENGTH=20,ATTRB=(ASKIP,BRT)
NOTES4   DFHMDF POS=(13,1),LENGTH=20,ATTRB=(ASKIP,BRT)
MSG      DFHMDF POS=(22,1),LENGTH=60,ATTRB=(ASKIP,BRT)
         DFHMDF POS=(24,1),LENGTH=40,ATTRB=ASKIP,                      X
               INITIAL='ENTER=GENERATE  CLEAR=REFRESH  PF3=EXIT'
         DFHMSD TYPE=FINAL
         END
