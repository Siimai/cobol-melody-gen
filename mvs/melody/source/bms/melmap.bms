         PRINT NOGEN
MELMAP   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               EXTATT=YES,CTRL=(FREEKB,FRSET)
MELMP1   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=31,ATTRB=(ASKIP,BRT),COLOR=YELLOW,    X
               INITIAL='MELO - MELODY GENERATOR (KICKS)'
         DFHMDF POS=(3,1),LENGTH=28,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='SCALE (1-8, BLANK = RANDOM)'
SCALE    DFHMDF POS=(3,31),LENGTH=1,ATTRB=(UNPROT,NUM,IC),COLOR=GREEN, X
               HILIGHT=UNDERLINE
         DFHMDF POS=(3,33),LENGTH=1,ATTRB=ASKIP
SCNAME   DFHMDF POS=(3,35),LENGTH=16,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(4,1),LENGTH=28,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='LENGTH (08-16, BLANK=RANDOM)'
NLEN     DFHMDF POS=(4,31),LENGTH=2,ATTRB=(UNPROT,NUM),COLOR=GREEN,    X
               HILIGHT=UNDERLINE
         DFHMDF POS=(4,34),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(5,1),LENGTH=28,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='TEMPO (040-240 BPM, DEF 120)'
TEMPO    DFHMDF POS=(5,31),LENGTH=3,ATTRB=(UNPROT,NUM),COLOR=GREEN,    X
               HILIGHT=UNDERLINE
         DFHMDF POS=(5,35),LENGTH=1,ATTRB=ASKIP
         DFHMDF POS=(7,1),LENGTH=6,ATTRB=ASKIP,COLOR=TURQUOISE,        X
               INITIAL='SCALE:'
SNAME    DFHMDF POS=(7,8),LENGTH=16,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(8,1),LENGTH=6,ATTRB=ASKIP,COLOR=TURQUOISE,        X
               INITIAL='NOTES:'
NCOUNT   DFHMDF POS=(8,8),LENGTH=2,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(8,12),LENGTH=6,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='TEMPO:'
NTEMPO   DFHMDF POS=(8,19),LENGTH=3,ATTRB=(ASKIP,BRT),COLOR=YELLOW
NOTES1   DFHMDF POS=(10,1),LENGTH=20,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
NOTES2   DFHMDF POS=(11,1),LENGTH=20,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
NOTES3   DFHMDF POS=(12,1),LENGTH=20,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
NOTES4   DFHMDF POS=(13,1),LENGTH=20,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
MSG      DFHMDF POS=(22,1),LENGTH=70,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(24,1),LENGTH=45,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='ENTER=RUN PF3=EXIT PF5=SAVE PF6=LIST PF7=MIDI'
         DFHMDF POS=(24,48),LENGTH=9,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='CLEAR=NEW'
MELMP2   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=31,ATTRB=(ASKIP,BRT),COLOR=YELLOW,    X
               INITIAL='MELO - MELODY GENERATOR (KICKS)'
         DFHMDF POS=(3,1),LENGTH=24,ATTRB=ASKIP,COLOR=TURQUOISE,       X
               INITIAL='SAVED MELODIES (LAST 10)'
ROW01    DFHMDF POS=(5,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW02    DFHMDF POS=(6,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW03    DFHMDF POS=(7,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW04    DFHMDF POS=(8,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW05    DFHMDF POS=(9,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW06    DFHMDF POS=(10,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW07    DFHMDF POS=(11,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW08    DFHMDF POS=(12,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW09    DFHMDF POS=(13,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
ROW10    DFHMDF POS=(14,1),LENGTH=44,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(17,1),LENGTH=13,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='LOAD NUMBER :'
LD       DFHMDF POS=(17,15),LENGTH=3,ATTRB=(UNPROT,NUM,IC),COLOR=GREEN,X
               HILIGHT=UNDERLINE
         DFHMDF POS=(17,19),LENGTH=1,ATTRB=ASKIP
MSG2     DFHMDF POS=(22,1),LENGTH=70,ATTRB=(ASKIP,BRT),COLOR=NEUTRAL
         DFHMDF POS=(24,1),LENGTH=26,ATTRB=ASKIP,COLOR=TURQUOISE,      X
               INITIAL='ENTER=LOAD  PF3=BACK'
         DFHMSD TYPE=FINAL
         END
