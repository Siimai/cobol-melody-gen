//MELASM   JOB (1),'MELODY',CLASS=A,MSGCLASS=A
//* Assembles MELODY.SOURCE.ASM(SCRSUB), the 3270 screen subroutine,
//* into MELODY.LOAD.  SETUP links it into the panel program MELSCR,
//* so run SETUP after this job (MELBUILD WHAT(ASM) runs both).
//* Run it with  SUBMIT 'MELODY.SOURCE.CNTL(SCRSUB)'
//ALLOC    EXEC PGM=IEFBR14
//LOAD     DD DSN=MELODY.LOAD,DISP=(MOD,CATLG),UNIT=SYSDA,
//         SPACE=(TRK,(5,5,5)),DCB=(RECFM=U,BLKSIZE=6144)
//ASM      EXEC ASMFCL
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(SCRSUB),DISP=SHR
//LKED.SYSLMOD DD DSN=MELODY.LOAD(SCRSUB),DISP=SHR
//
