//MELKTBL  JOB (1),'MELODY',CLASS=A,MSGCLASS=A
//* Assembles the KICKS tables MELPPT and MELPCT (suffix ML) into
//* the KICKS SKIKLOAD library as KIKPPTML and KIKPCTML (the User's
//* Guide names the objects KIKPPT?? and KIKPCT??).  Start KICKS with
//*   KICKS PPT(ML) PCT(ML)
//* TO CONFIRM before the first run (the guide does not name them):
//*   - the KICKS macro library for SYSLIB (LISTCAT LEVEL(KICKS))
//*   - the SKIKLOAD data set that the KICKS CLIST searches first
//* Run it with  SUBMIT 'MELODY.SOURCE.CNTL(MELKTBL)'
//PPT      EXEC ASMFCL
//ASM.SYSLIB DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(MELPPT),DISP=SHR
//LKED.SYSLMOD DD DSN=KICKS.KICKS.V1R5M0.SKIKLOAD(KIKPPTML),DISP=SHR
//PCT      EXEC ASMFCL
//ASM.SYSLIB DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(MELPCT),DISP=SHR
//LKED.SYSLMOD DD DSN=KICKS.KICKS.V1R5M0.SKIKLOAD(KIKPCTML),DISP=SHR
//
