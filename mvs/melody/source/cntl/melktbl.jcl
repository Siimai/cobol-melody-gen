//MELKTBL  JOB (1),'MELODY',CLASS=A,MSGCLASS=A
//* Assembles the four KICKS tables of MELO, suffix ML, into the
//* KICKS SKIKLOAD library: MELPPT -> KIKPPTML, MELPCT -> KIKPCTML,
//* MELFCT -> KIKFCTML, MELDCT -> KIKDCTML (the User's Guide names
//* the objects KIKPPT??, KIKPCT??, KIKFCT?? and KIKDCT??).  The
//* MELOKICK CLIST starts KICKS with PPT(ML) PCT(ML) FCT(ML) DCT(ML).
//* The BLKSIZE on SYSLIB matches SYS1.MACLIB, which ASMFCL adds behind
//* it: the assembler needs the largest block size first.
//* Run it with  SUBMIT 'MELODY.SOURCE.CNTL(MELKTBL)'
//PPT      EXEC ASMFCL
//ASM.SYSLIB DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR,
//         DCB=BLKSIZE=19040
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(MELPPT),DISP=SHR
//LKED.SYSLMOD DD DSN=KICKS.KICKS.V1R5M0.SKIKLOAD(KIKPPTML),DISP=SHR
//PCT      EXEC ASMFCL
//ASM.SYSLIB DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR,
//         DCB=BLKSIZE=19040
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(MELPCT),DISP=SHR
//LKED.SYSLMOD DD DSN=KICKS.KICKS.V1R5M0.SKIKLOAD(KIKPCTML),DISP=SHR
//FCT      EXEC ASMFCL
//ASM.SYSLIB DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR,
//         DCB=BLKSIZE=19040
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(MELFCT),DISP=SHR
//LKED.SYSLMOD DD DSN=KICKS.KICKS.V1R5M0.SKIKLOAD(KIKFCTML),DISP=SHR
//DCT      EXEC ASMFCL
//ASM.SYSLIB DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR,
//         DCB=BLKSIZE=19040
//ASM.SYSIN DD DSN=MELODY.SOURCE.ASM(MELDCT),DISP=SHR
//LKED.SYSLMOD DD DSN=KICKS.KICKS.V1R5M0.SKIKLOAD(KIKDCTML),DISP=SHR
//
