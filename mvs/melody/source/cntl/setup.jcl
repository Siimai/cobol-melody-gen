//MELCOB   JOB (1),'MELODY',CLASS=A,MSGCLASS=A
//* Compiles MELODY68, MELVAL, MELSAV and MELMID from MELODY.SOURCE.COBOL
//* into MELODY.LOAD.
//* Run it with  SUBMIT 'MELODY.SOURCE.CNTL(SETUP)'  as a user with
//* UPDATE on MELODY.* (group MELODY or ADMIN).
//ALLOC    EXEC PGM=IEFBR14
//LOAD     DD DSN=MELODY.LOAD,DISP=(MOD,CATLG),UNIT=SYSDA,
//         SPACE=(TRK,(5,5,5)),DCB=(RECFM=U,BLKSIZE=6144)
//COMP     EXEC COBUCL
//COB.SYSIN DD DSN=MELODY.SOURCE.COBOL(MELODY68),DISP=SHR
//LKED.SYSLMOD DD DSN=MELODY.LOAD(MELODY68),DISP=SHR
//COMPV    EXEC COBUCL
//COB.SYSIN DD DSN=MELODY.SOURCE.COBOL(MELVAL),DISP=SHR
//LKED.SYSLMOD DD DSN=MELODY.LOAD(MELVAL),DISP=SHR
//COMPS    EXEC COBUCL
//COB.SYSIN DD DSN=MELODY.SOURCE.COBOL(MELSAV),DISP=SHR
//LKED.SYSLMOD DD DSN=MELODY.LOAD(MELSAV),DISP=SHR
//COMPM    EXEC COBUCL
//COB.SYSIN DD DSN=MELODY.SOURCE.COBOL(MELMID),DISP=SHR
//LKED.SYSLMOD DD DSN=MELODY.LOAD(MELMID),DISP=SHR
//
