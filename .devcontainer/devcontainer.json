{
  "name": "claude",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "ubuntu",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/ubuntu/.claude"
  },
  "postCreateCommand": "[ -d ~/claude-tk4 ] || gh repo clone Siimai/claude-tk4 ~/claude-tk4 || echo 'clone Siimai/claude-tk4 to ~/claude-tk4 after gh auth login'",
  "mounts": [
    "source=claude-config,target=/home/ubuntu/.claude,type=volume",
    "source=gh-config,target=/home/ubuntu/.config/gh,type=volume",
    "source=${localEnv:HOME}/opt/tk4-_v1.00_current/prt,target=/mnt/tk4-prt,type=bind,readonly"
  ]
}
