# Compiler artifacts (binary + shared objects)
gnucobol/build/

# Generated melody output files (keep the directory, not the contents)
gnucobol/output/*
!gnucobol/output/.gitkeep

# Plan drafts — local only; promoted to GitHub issues when approved
plans/

# macOS
.DS_Store

# Local secrets (never commit)
mvs/.secrets/

# Third-party KICKS distribution (downloaded, never commit). The KICKS
# license forbids putting its objects in public repositories, so all
# local KICKS install work stays out of git too.
mvs/kicks-tso-v1r5m0.zip
mvs/kicks-tso-v1r5m0/
mvs/kicks/
*.xmi

# Local tool config
zapp.yaml

# Local Claude Code settings
.claude/settings.local.json
